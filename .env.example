# =============================================================================
# SIS International — environment variable template
# Copy this file to .env and fill in every value before running any worker.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API keys
# -----------------------------------------------------------------------------

# SuperSend.io API key (https://app.supersend.io → Settings → API)
SS_API_KEY=

# MillionVerifier bulk API key (https://app.millionverifier.com → API)
MV_API_KEY=

# Apollo.io API key — optional, API client exists but is not yet active
APOLLO_API_KEY=

# -----------------------------------------------------------------------------
# Email account passwords
# -----------------------------------------------------------------------------

# Password for the primary GoDaddy/Office365 SMTP account used by smtp_worker
GODADDY_PASSWORD=

# Password for the primary BCC Gmail account (nancy@sisinternational.com)
BCC_PASSWORD=

# Password for the Shubha BCC Gmail account (shubha@sisinternational.com)
SHUBHA_BCC_PASSWORD=

# Password for the Incentives BCC Gmail account (incentives@sisinternational.com)
INCENTIVES_BCC_PASSWORD=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Absolute path to the active SQLite database file
SQLITE_DB_PATH=

# -----------------------------------------------------------------------------
# Base / campaign paths
# Typically point to a shared Google Drive folder mounted locally.
# projects_base_path and db_file_path are derived from BASE_PATH automatically.
# -----------------------------------------------------------------------------

# Root of the shared Google Drive utilities folder (e.g. .../alberto/utilities)
BASE_PATH=

# Absolute path to blast_master_good_final.xlsx (campaign templates & copy)
BLAST_MASTER_PATH=

# Absolute path to mm_list.csv (mailmerge send list written by smtp_worker)
MM_READY_CSV=

# Absolute path to the mailing_bot directory (per-account mailmerge folders)
MAILING_PATH=

# Absolute path to log.csv (legacy outreach log written by smtp_bot)
LOG_PATH=

# Absolute path to godaddy_emails.csv (SMTP account list)
GODADDY_EMAILS_PATH=

# Absolute path to footer_bcc.txt (HTML footer appended to BCC emails)
BCC_FOOTER_PATH=

# -----------------------------------------------------------------------------
# Local working directories
# -----------------------------------------------------------------------------

# Temp directory for general scratch files
TEMP_DIR=

# Temp directory used by database_worker (lock file, staging files)
TEMP_DB_DIR=

# Temp directory used by million_verifier_worker (upload/download staging)
MV_TEMP_DIR=

# Directory where CSV files are dropped for database_worker to ingest
# Naming convention: {source}--{project_id}__{filename}.csv
DATABASE_INPUT_DIR=

# Directory where CSVs are moved if they fail schema validation
FAILED_DATABASE_INPUT_DIR=

# Directory where CSVs are moved when they require manual column mapping
MANUAL_CLEANING_DIR=

# -----------------------------------------------------------------------------
# Local file paths
# -----------------------------------------------------------------------------

# Absolute path to database_mappers.json (CSV column → DB column mapping rules)
DATABASE_MAPPERS_PATH=

# Absolute path to footer.txt (HTML footer appended to SMTP mailmerge emails)
FOOTER_PATH=

# -----------------------------------------------------------------------------
# Lock files — one per worker; must not be shared between workers
# -----------------------------------------------------------------------------

# Lock file for database_worker (prevents concurrent CSV ingestion)
DB_LOCK_FILE_PATH=

# Lock file for super_send_worker (prevents concurrent SuperSend uploads)
SS_LOCK_FILE_PATH=

# Lock file for million_verifier_worker (prevents concurrent MV polling)
MV_LOCK_FILE_PATH=

# Lock file for smtp_worker (prevents concurrent mailmerge runs)
SMTP_LOCK_FILE_PATH=

# Lock file for bcc_bot_worker / manual_bcc_bot (separate from SMTP lock)
BCC_LOCK_FILE_PATH=

# -----------------------------------------------------------------------------
# Log files
# -----------------------------------------------------------------------------

SS_LOG_FILE=
MV_LOG_FILE=
DB_LOG_FILE=
SMTP_LOG_FILE=
BCC_LOG_FILE=
